+// The key items the case does not hold yet, each into the case where there is room (putIn, as a found item goes).
+// `added` the ones put in now, `had` the ones it held, `failed` the ones without room. True when none failed.
+bool giveKeyItems(int* added, int* had, int* failed)
+{
+    *added = *had = *failed = 0;
+    for (u16 id : kKeyItems) {
+        if (ItemMgr.search(id)) {
+            ++*had;
+            continue;
+        }
+        if (putIn(id, 1) && ItemMgr.search(id)) {
+            ++*added;
+        } else {
+            ++*failed;
